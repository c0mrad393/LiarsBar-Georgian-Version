{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "liarsbar",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LEDGER", "class_name": "Ledger" },
      { "name": "MATCH", "class_name": "Matchmaker" }
    ]
  },
  // Free plan: Durable Objects must be SQLite-backed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Ledger"] },
    { "tag": "v3", "new_sqlite_classes": ["Matchmaker"] }
  ],
  "observability": { "enabled": true }
}
